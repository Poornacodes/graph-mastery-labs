# Listing 6.1 — Facts in Turtle
@prefix ex:   <http://example.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:alice  rdf:type   foaf:Person ;      # ';' = same subject, new predicate
          foaf:name  "Alice" ;
          foaf:age   30 ;
          foaf:knows ex:bob ;
          ex:worksAt ex:acme .

ex:acme   rdf:type   ex:Organization ;
          foaf:name  "Acme Corp" .
