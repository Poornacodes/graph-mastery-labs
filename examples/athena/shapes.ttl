# Section E.5 — every Person needs a name; a Project has at most one lead.
@prefix ex:  <http://helios.example/> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ] .

ex:ProjectShape a sh:NodeShape ;
  sh:targetClass ex:Project ;
  sh:property [ sh:path [ sh:inversePath ex:leads ] ; sh:maxCount 1 ;
                sh:message "A project has at most one lead." ] .
