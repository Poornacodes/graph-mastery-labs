# Copy to .env and adjust. Every lab reads these (graphlab/config.py).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmastery
FUSEKI_PASSWORD=graphmastery

# LLM for Chapters 9, 11 and examples/athena:
#   offline   (default) no model; uses cached extractions and extractive answers
#   ollama    local and free: install Ollama, then `ollama pull llama3.1`
#   anthropic Claude via the Anthropic API (pip install -r requirements-llm.txt)
#   bedrock   Claude on Amazon Bedrock (Chapter 13; needs AWS credentials)
LLM_PROVIDER=offline
# LLM_MODEL=            # optional override of the provider's default model
# AWS_REGION=us-east-1

# Embeddings: a local sentence-transformers model, or "hash" (offline, weaker)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
